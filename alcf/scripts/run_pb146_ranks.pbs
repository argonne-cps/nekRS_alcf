#!/bin/bash
#PBS -A Catalyst
#PBS -N nekRS_pb146
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -k doe
#PBS -j oe

# Run the nekRS "pb146" example on 1, 2 and 12 ranks (one rank per PVC GPU tile), one after another.
# Each rank count runs in its own directory run/pb146_<n>r, seeded from run/pb146_src
# (pb.re2 pre-extracted from the example's pb.re2.tgz). The run is capped at NUMSTEPS steps
# (the stock par file runs 10000 steps) so it fits in a debug job.

export TZ='/usr/share/zoneinfo/US/Central'

TOP=/lus/flare/projects/catalyst/world_shared/sspatel/scheel
export NEKRS_HOME=$TOP/nekrs_install
CASE=pb
RANK_COUNTS=${RANK_COUNTS:-"1 2 12"}
NUMSTEPS=${NUMSTEPS:-100}
CPU_BINDS=(1-8 9-16 17-24 25-32 33-40 41-48 53-60 61-68 69-76 77-84 85-92 93-100)
BIN=$NEKRS_HOME/bin/nekrs

echo "Jobid: $PBS_JOBID  host: $(hostname)  start: $(date)"

module load cmake
module list 2>&1
ulimit -s unlimited

export NEKRS_GPU_MPI=0
export MPICH_GPU_SUPPORT_ENABLED=0
export NEKRS_CACHE_BCAST=1
export NEKRS_LOCAL_TMP_DIR=/tmp/
export OCCA_DPCPP_COMPILER_FLAGS="-O3 -fsycl -fsycl-targets=intel_gpu_pvc -ftarget-register-alloc-mode=pvc:auto -fma"
export FI_CXI_RX_MATCH_MODE=hybrid   # required by parRSB
export UR_L0_USE_COPY_ENGINE=0       # runtime workaround

for n in $RANK_COUNTS; do
  dir=$TOP/run/pb146_${n}r
  mkdir -p $dir
  cp $TOP/run/pb146_src/$CASE.{par,re2,udf,usr} $dir/
  cd $dir
  sed -i -e 's/^stopAt *=.*/stopAt = numSteps\nnumSteps = '$NUMSTEPS'/' $CASE.par

  cat > .lhelper <<'EOF'
#!/bin/bash
gpu_id=$(((PALS_LOCAL_RANKID / 2) % 6))
tile_id=$((PALS_LOCAL_RANKID % 2))
export ZE_AFFINITY_MASK=$gpu_id.$tile_id
"$@"
EOF
  chmod u+x .lhelper

  bind=$(IFS=:; echo "${CPU_BINDS[*]:0:$n}")

  echo "========== $CASE with $n rank(s), bind $bind: $(date) =========="
  NEKRS_JITC_NTHREADS=8 timeout 10m mpiexec -n $n -ppn $n --cpu-bind=list:$bind -- \
    ./.lhelper $BIN --setup $CASE --backend dpcpp --device-id 0 --build-only $n > build.log 2>&1
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "precompilation for $n rank(s) failed (exit $rc), see $dir/build.log"
    continue
  fi

  timeout 12m mpiexec -n $n -ppn $n --cpu-bind=list:$bind -- \
    ./.lhelper $BIN --setup $CASE --backend dpcpp --device-id 0 > run.log 2>&1
  rc=$?
  echo "Run with $n rank(s) finished (exit $rc): $(date)"
  grep -E "initialization took|^step= *[0-9]+ +t=" run.log | sed -n '1p;$p'
  grep "totalElapsed" run.log | tail -1
done

echo "All done: $(date)"
