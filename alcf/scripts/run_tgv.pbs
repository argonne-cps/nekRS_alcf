#!/bin/bash
#PBS -A Catalyst
#PBS -N nekRS_tgv
#PBS -q debug
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -k doe
#PBS -j oe

# Run the nekRS "tgv" example on 1 Aurora node (6 PVC GPUs x 2 tiles = 12 ranks).
# Settings mirror nekRS_HPCsupport/Aurora/nrsqsub.

export TZ='/usr/share/zoneinfo/US/Central'

TOP=/lus/flare/projects/catalyst/world_shared/sspatel/scheel
export NEKRS_HOME=$TOP/nekrs_install
CASE=tgv
NODES=1
RANKS_PER_NODE=12
TOTAL_RANKS=$(( NODES * RANKS_PER_NODE ))
CPU_BIND_LIST="1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100"
BIN=$NEKRS_HOME/bin/nekrs

cd $TOP/run/tgv
echo "Jobid: $PBS_JOBID  host: $(hostname)  start: $(date)"
echo "Nodes: $(cat $PBS_NODEFILE)"

module load cmake
module list 2>&1
ulimit -s unlimited

export NEKRS_GPU_MPI=0
export MPICH_GPU_SUPPORT_ENABLED=0
export NEKRS_CACHE_BCAST=1
export NEKRS_LOCAL_TMP_DIR=/tmp/
export OCCA_DPCPP_COMPILER_FLAGS="-O3 -fsycl -fsycl-targets=intel_gpu_pvc -ftarget-register-alloc-mode=pvc:auto -fma"
export FI_CXI_RX_MATCH_MODE=hybrid   # required by parRSB
export UR_L0_USE_COPY_ENGINE=0       # runtime workaround

# Bind each rank to one GPU tile
cat > .lhelper <<'EOF'
#!/bin/bash
gpu_id=$(((PALS_LOCAL_RANKID / 2) % 6))
tile_id=$((PALS_LOCAL_RANKID % 2))
export ZE_AFFINITY_MASK=$gpu_id.$tile_id
"$@"
EOF
chmod u+x .lhelper

# 1) JIT-precompile kernels for $TOTAL_RANKS ranks
date
NEKRS_JITC_NTHREADS=8 mpiexec -n 12 -ppn 12 --cpu-bind=list:${CPU_BIND_LIST} -- \
  ./.lhelper $BIN --setup $CASE --backend dpcpp --device-id 0 --build-only $TOTAL_RANKS
if [ $? -ne 0 ]; then echo "precompilation failed"; exit 1; fi
date

# 2) Actual run
mpiexec -n $TOTAL_RANKS -ppn $RANKS_PER_NODE --cpu-bind=list:${CPU_BIND_LIST} -- \
  ./.lhelper $BIN --setup $CASE --backend dpcpp --device-id 0
echo "Run finished (exit $?): $(date)"
